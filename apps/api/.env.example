# Copy to .env and fill in real values. Never commit .env.
# Production boot (`validateStartupConfig()` in src/config/envConfig.ts)
# throws unless DATABASE_URL, JWT_SECRET, and RAGX_ENCRYPTION_KEY are set
# and valid. Never log this file's values.
DATABASE_URL=postgresql://user:password@localhost:5432/ragx
# Session signing secret: min 32 chars, unpredictable, never committed.
# Generate: openssl rand -hex 32
# Tokens are HS256, issuer "ragx-api". Production rejects known-insecure
# values such as "change-me-in-production".
JWT_SECRET=
PORT=3000
NODE_ENV=development
# Session + auth-cookie lifetime. Seconds ("3600") or number with
# s/m/h/d/w suffix ("15m", "12h", "7d"). Cookie maxAge tracks this value.
JWT_EXPIRES_IN=7d
# 32-byte server-side key for provider credential encryption (AES-256-GCM).
# Accepted formats: 64-char hex, 44-char base64 (decodes to 32 bytes),
# or 32 raw chars. Generate: openssl rand -hex 32
# Server-only. Never expose via NEXT_PUBLIC_* or API responses.
RAGX_ENCRYPTION_KEY=
# Dashboard origin allowed for credentialed CORS requests.
WEB_APP_URL=http://localhost:3000
# Filesystem root for the LocalObjectStorage driver (see Modules/Storage).
# Server-only. Defaults to ./storage when unset.
RAGX_STORAGE_DIR=./storage
# API key for the Gemini Guard model.
GEMINI_GUARD_API_KEY=
